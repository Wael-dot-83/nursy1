# ==============================================
# NURSERY MANAGEMENT SYSTEM - ENVIRONMENT CONFIG
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# PostgreSQL (Production)
DATABASE_URL=postgresql://nursery_user:your_secure_password@localhost:5432/nursery_db

# Connection Pool Settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ==============================================
# JWT & AUTHENTICATION
# ==============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_RANDOM_32_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================
# SECURITY SETTINGS
# ==============================================
# Password Hashing (12-14 recommended for production)
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Session Settings
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# ==============================================
# FILE UPLOAD CONFIGURATION
# ==============================================
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx,xls,xlsx
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# ==============================================
# EMAIL CONFIGURATION (Optional)
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@nursery.com
SMTP_FROM_NAME=Nursery Management System

# ==============================================
# MONITORING & LOGGING
# ==============================================
# Sentry DSN for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================
VITE_API_URL=http://localhost:8002
VITE_WS_URL=ws://localhost:8002/ws
VITE_APP_NAME=Nursery Management System
VITE_APP_VERSION=2.0.0

# ==============================================
# REDIS (Optional - for caching/sessions)
# ==============================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password

# ==============================================
# BACKUP CONFIGURATION
# ==============================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_HOUR=2

# ==============================================
# FEATURE FLAGS
# ==============================================
ENABLE_REGISTRATION=false
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_API_DOCS=true

# ==============================================
# DEVELOPMENT SETTINGS
# ==============================================
DEBUG=false
RELOAD=false
WORKERS=4

# ==============================================
# PRODUCTION SETTINGS
# ==============================================
# Set to 'production' in production environment
ENVIRONMENT=development

# SSL/TLS
SSL_CERT_FILE=./certs/cert.pem
SSL_KEY_FILE=./certs/key.pem

# Domain
DOMAIN=nursery.example.com
PROTOCOL=https
