# Application Settings
APP_NAME=Nursery Management System
VERSION=1.0.0
DEBUG=false

# Security - CHANGE THESE IN PRODUCTION
SECRET_KEY=your-secret-key-min-32-chars-change-in-production
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=sqlite:///./nursery.db

# SMS (Twilio) - Optional
SMS_TWILIO_SID=
SMS_TWILIO_TOKEN=
SMS_TWILIO_PHONE=
SMS_DEV_MODE=true

# Email (SMTP) - Optional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@nursery.com

# File Storage
FILES_BASE_DIR=./storage
MAX_FILE_SIZE=10485760

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=5

# Password Reset
OTP_EXPIRE_MINUTES=10
MAX_OTP_ATTEMPTS=5
MAX_RESET_ATTEMPTS_PER_DAY=2
OTP_REQUEST_RATE_LIMIT=3/hour
PASSWORD_RESET_RATE_LIMIT=2/day

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
