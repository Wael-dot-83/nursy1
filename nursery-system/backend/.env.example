# Application Settings
APP_NAME="Nursery Management System"
VERSION="1.0.0"
DEBUG=False

# Security - IMPORTANT: Generate secure random keys for production
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ACCESS_SECRET=your-jwt-access-secret-here-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here-change-in-production

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10

# Database - Update with your database credentials
DATABASE_URL=mysql+mysqlconnector://username:password@localhost:3306/nursery_db

# SMS (Twilio) - Optional
SMS_TWILIO_SID=
SMS_TWILIO_TOKEN=
SMS_TWILIO_PHONE=

# Email (SMTP) - Optional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# File Storage
FILES_BASE_DIR=./storage
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
