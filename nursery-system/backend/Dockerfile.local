# Multi-stage Dockerfile for FastAPI backend (local development)
ARG PYTHON_VERSION=3.11

# ============================================================================
# STAGE 1: Builder - Install dependencies
# ============================================================================
FROM python:${PYTHON_VERSION}-slim as builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    make \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --user --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --user -r requirements.txt

# ============================================================================
# STAGE 2: Runner - Minimal runtime image
# ============================================================================
FROM python:${PYTHON_VERSION}-slim as runner

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 nursery && \
    mkdir -p /app/storage /app/logs /app/uploads && \
    chown -R nursery:nursery /app

# Copy Python dependencies from builder
COPY --from=builder --chown=nursery:nursery /root/.local /home/nursery/.local

# Copy application code
COPY --chown=nursery:nursery . .

# Install the app package in editable mode for proper imports
USER root
RUN pip install -e .
USER nursery

# Set environment variables
ENV PATH=/home/nursery/.local/bin:$PATH \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8

# Switch to non-root user
USER nursery

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Copy entrypoint script
COPY --chown=nursery:nursery docker-entrypoint.sh /usr/local/bin/
USER root
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
USER nursery

# Entrypoint: run migrations, seed, then start server
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Default command: run uvicorn with multiple workers
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--log-level", "info", "--proxy-headers", "--forwarded-allow-ips", "*"]
