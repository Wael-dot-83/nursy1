generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SUPERVISOR
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Nursery {
  id         String      @id @default(uuid())
  name       String
  address    String
  city       String
  district   String
  phone      String?
  email      String?
  users      User[]
  children   Child[]
  classrooms Classroom[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  passwordHash     String
  fullName         String
  phone            String          @unique
  role             Role
  nurseryId        String?
  nursery          Nursery?        @relation(fields: [nurseryId], references: [id])
  classrooms       Classroom[]     @relation("ClassroomSupervisor")
  children         Child[]         @relation("ParentChildren")
  reports          Report[]        @relation("ReportSupervisor")
  attendance       Attendance[]    @relation("AttendanceRecorder")
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([role])
  @@index([nurseryId])
}

model Classroom {
  id           String     @id @default(uuid())
  name         String
  description  String?
  nurseryId    String
  nursery      Nursery    @relation(fields: [nurseryId], references: [id])
  supervisorId String?
  supervisor   User?      @relation("ClassroomSupervisor", fields: [supervisorId], references: [id])
  children     Child[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Child {
  id            String         @id @default(uuid())
  firstName     String
  lastName      String
  birthDate     DateTime
  guardianNote  String?
  parentId      String
  parent        User           @relation("ParentChildren", fields: [parentId], references: [id])
  classroomId   String?
  classroom     Classroom?     @relation(fields: [classroomId], references: [id])
  nurseryId     String
  nursery       Nursery        @relation(fields: [nurseryId], references: [id])
  attendance    Attendance[]
  reports       Report[]
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Attendance {
  id           String           @id @default(uuid())
  date         DateTime
  status       AttendanceStatus
  notes        String?
  checkIn      DateTime?
  checkOut     DateTime?
  childId      String
  child        Child            @relation(fields: [childId], references: [id])
  recordedById String
  recordedBy   User             @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([childId, date])
}

model Report {
  id           String    @id @default(uuid())
  childId      String
  child        Child     @relation(fields: [childId], references: [id])
  supervisorId String
  supervisor   User      @relation("ReportSupervisor", fields: [supervisorId], references: [id])
  weekStart    DateTime
  weekEnd      DateTime
  summary      String
  highlights   String?
  nextSteps    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([childId, weekStart])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  parentId  String
  parent    User     @relation(fields: [parentId], references: [id])
  childId   String?
  child     Child?   @relation(fields: [childId], references: [id])
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([parentId])
  @@index([childId])
}
